<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard</title>

    <!-- ✅ BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🛠️ Admin Dashboard</h2>

        <a href="/access-logs" class="btn btn-primary">
            📊 Access Logs
        </a>
    </div>

    <!-- 🔥 FLASH MESSAGES -->
    <% if (success && success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show">
            <%= success %>
            <button class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <% if (error && error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show">
            <%= error %>
            <button class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- ===================== -->
    <!-- REGISTER -->
    <!-- ===================== -->
    <div class="card p-3 mb-4 shadow-sm">

        <h5 class="mb-3">➕ Add Developer</h5>

        <form method="POST" action="/register">

            <div class="row g-2">

                <div class="col-md-3">
                    <input name="username" class="form-control" placeholder="Username" required>
                </div>

                <div class="col-md-3">
                    <input name="email" class="form-control" placeholder="Email" required>
                </div>

                <div class="col-md-2">
                    <input type="date" name="dob" class="form-control" required>
                </div>

                <div class="col-md-2">
                    <input type="password" name="password" class="form-control" placeholder="Password" required>
                </div>

                <div class="col-md-2">
                    <button class="btn btn-success w-100">Add</button>
                </div>

            </div>

        </form>

    </div>

    <!-- ===================== -->
    <!-- TABLE -->
    <!-- ===================== -->
    <div class="card shadow-sm">

        <div class="card-header bg-dark text-white">
            Developer List
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>DOB</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    <% if (users.length === 0) { %>
                        <tr>
                            <td colspan="6" class="text-center text-danger">
                                No developers found
                            </td>
                        </tr>
                    <% } %>

                    <% users.forEach(user => { %>

                    <!-- 🔥 UPDATE FORM PER ROW -->
                    <form method="POST" action="/update/<%= user.id %>">

                    <tr>

                        <td><%= user.id %></td>

                        <!-- EDITABLE FIELDS -->
                        <td>
                            <input name="username" value="<%= user.username %>" class="form-control" required>
                        </td>

                        <td>
                            <input name="email" value="<%= user.email %>" class="form-control" required>
                        </td>

                        <td>
                          <input 
    type="date"
    name="dob"
    value="<%= user.dob ? user.dob.slice(0,10) : '' %>"
    class="form-control"
    required
>
                        </td>

                        <!-- STATUS -->
                        <td>
                            <% if (user.is_blocked) { %>
                                <span class="badge bg-danger">Blocked</span>
                            <% } else { %>
                                <span class="badge bg-success">Active</span>
                            <% } %>
                        </td>

                        <!-- ACTIONS -->
                        <td>

                            <div class="d-flex gap-1 flex-wrap">

                                <!-- 🔥 UPDATE -->
                                <button class="btn btn-primary btn-sm">
                                    Update
                                </button>

                                <!-- 🔥 BAN / UNBAN -->
                                <% if (user.is_blocked) { %>
                                    <a href="/unblock/<%= user.id %>" 
                                       class="btn btn-warning btn-sm">
                                        Unban
                                    </a>
                                <% } else { %>
                                    <a href="/ban/<%= user.id %>" 
                                       class="btn btn-danger btn-sm">
                                        Ban
                                    </a>
                                <% } %>

                                <!-- DELETE -->
                                <a href="/delete/<%= user.id %>" 
                                   class="btn btn-dark btn-sm"
                                   onclick="return confirm('Delete this developer?')">
                                    Delete
                                </a>

                                <!-- ACTIVITY -->
                                <a href="/developer-activity/<%= user.id %>" 
                                   class="btn btn-info btn-sm">
                                    Activity
                                </a>

                            </div>

                        </td>

                    </tr>

                    </form>

                    <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
