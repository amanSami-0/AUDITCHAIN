<!DOCTYPE html>
<html>
<head>

    <title>Developer Activity</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f5f6fa;
        }

        .table td {
            vertical-align: middle;
        }
    </style>

</head>

<body>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>📊 Developer Activity Logs</h2>

        <a href="/access-logs" class="btn btn-secondary">
            ⬅ Back to Access Logs
        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-dark text-white">
            Activity Timeline
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover table-striped">

                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Action</th>
                            <th>IP Address</th>
                            <th>Device</th>
                            <th>Location</th>
                            <th>Time</th>
                        </tr>
                    </thead>

                    <tbody>

                    <% if (logs.length === 0) { %>
                        <tr>
                            <td colspan="6" class="text-center text-danger">
                                No activity found
                            </td>
                        </tr>
                    <% } %>

                    <% logs.forEach((l, index) => { %>

                    <tr>

                        <td><%= index + 1 %></td>

                        <td>
                            <span class="badge 
                                <%= l.action === 'UNAUTHORIZED_INTRUDER' ? 'bg-danger' : 'bg-success' %>">
                                <%= l.action %>
                                <% if (l.developer_id) { %>
                                    (ID: <%= l.developer_id %>)
                                <% } %>
                            </span>
                        </td>

                        <td><%= l.ip_address || "Unknown" %></td>

                        <td style="max-width:200px; word-break: break-word;">
                            <%= l.device || "Unknown" %>
                        </td>

                        <td><%= l.location || "Unknown" %></td>

                        <td>
                            <%= new Date(l.time).toLocaleString() %>
                        </td>

                    </tr>

                    <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

</body>
</html>
