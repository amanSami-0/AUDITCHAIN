<!DOCTYPE html>
<html>
<head>

<title>Access Logs</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="bg-light">

<div class="container mt-4">

<h2 class="mb-3">📊 Access Logs</h2>

<a href="/admin" class="btn btn-secondary mb-3">⬅ Back</a>

<!-- 🔍 SEARCH -->
<form method="get" class="mb-3">

<div class="input-group">

<input 
    type="number" 
    name="developer_id" 
    class="form-control" 
    placeholder="Enter Developer ID"
    value="<%= developer_id || '' %>"
>

<button class="btn btn-primary">Search</button>

</div>

</form>

<!-- ❌ ERROR POPUP -->
<% if (error) { %>
<script>
    alert("<%= error %>");
</script>
<% } %>

<!-- 📊 TABLE -->
<table class="table table-bordered">

<tr>
<th>ID</th>
<th>Developer</th>
<th>IP</th>
<th>Device</th>
<th>Login</th>
<th>Status</th>
<th>Action</th>
</tr>

<% logs.forEach(log => { %>

<tr>

<td><%= log.id %></td>

<td><%= userMap[log.developer_id] %></td>

<td><%= log.ip_address %></td>

<td style="max-width:200px;"><%= log.device %></td>

<td><%= log.login_time %></td>

<td>
<% if (!log.logout_time) { %>
<span class="badge bg-success">Active</span>
<% } else { %>
<span class="badge bg-secondary">Logged Out</span>
<% } %>
</td>

<td>
<% if (!log.logout_time) { %>
<a href="/kick/<%= log.session_id %>" class="btn btn-danger btn-sm">Kick</a>
<% } %>
</td>

</tr>

<% }) %>

</table>

</div>

</body>
</html>
