<!DOCTYPE html>
<html>

<head>
    <title>Audit Logs</title>

    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <style>
        body {
            background-color: #f5f6fa;
        }

        .table td {
            vertical-align: middle;
        }

        .hash {
            font-size: 10px;
            word-break: break-all;
        }

        .badge {
            font-size: 12px;
        }
    </style>
</head>

<body>

<div class="container mt-5">

    <h2 class="mb-4 text-center">🔐 Audit Logs Dashboard</h2>

    <div class="table-responsive">

        <table class="table table-bordered table-hover table-striped">

            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Method</th>
                    <th>Page</th>
                    <th>IP</th>
                    <th>Device</th>
                    <th>Status</th>
                    <th>Attempts</th>
                    <th>Visits</th>
                    <th>Previous Hash</th>
                    <th>Current Hash</th>
                    <th>Time</th>
                </tr>
            </thead>

            <tbody>

                <% logs.forEach(log => { %>

                <tr>

                    <td><%= log.id %></td>

                    <td><%= log.user_id || "-" %></td>

                    <td>
                        <span class="badge bg-primary">
                            <%= log.action %>
                        </span>
                    </td>

                    <td><%= log.method || "-" %></td>

                    <td><%= log.page %></td>

                    <td><%= log.ip_address %></td>

                    <td style="max-width:200px; word-break: break-word;">
                        <%= log.device %>
                    </td>

                    <td>
                        <% if (log.status === "FAILED") { %>
                            <span class="badge bg-danger">FAILED</span>
                        <% } else if (log.status === "SUSPICIOUS") { %>
                            <span class="badge bg-warning text-dark">SUSPICIOUS</span>
                        <% } else if (log.status === "BLOCKED") { %>
                            <span class="badge bg-dark">BLOCKED</span>
                        <% } else if (log.status === "LOGGED_IN") { %>
                            <span class="badge bg-success">LOGGED IN</span>
                        <% } else { %>
                            <span class="badge bg-secondary"><%= log.status %></span>
                        <% } %>
                    </td>

                    <td><%= log.attempt_count || 0 %></td>

                    <td><%= log.visit_count || 1 %></td>

                    <td class="hash"><%= log.previous_hash %></td>

                    <td class="hash"><%= log.current_hash %></td>

                    <td><%= log.createdAt %></td>

                </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>

</body>
</html>
