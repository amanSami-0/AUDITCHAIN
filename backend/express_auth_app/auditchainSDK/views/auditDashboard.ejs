<!DOCTYPE html>
<html>

<head>
    <title>Audit Logs</title>

    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <style>
        body {
            background-color: #f5f6fa;
        }

        .hash {
            font-size: 10px;
            word-break: break-all;
        }
    </style>
</head>

<body>

<div class="container mt-5">

    <!-- 🔥 LOGOUT -->
    <div class="text-end mb-3">
        <a href="/audit/logout" class="btn btn-danger">
            🚪 Logout
        </a>
    </div>

    <h2 class="mb-4 text-center">🔐 Audit Logs Dashboard (Blockchain)</h2>

    <!-- 🔍 SEARCH -->
    <form method="GET" action="/audit" class="mb-3">
        <div class="input-group">
            <input type="text"
                   name="user_id"
                   value="<%= user_id || '' %>"
                   class="form-control"
                   placeholder="Enter User ID (Blockchain does not filter by this currently)">
            <button class="btn btn-primary">
                Search
            </button>
            <a href="/audit" class="btn btn-secondary">
                Reset
            </a>
        </div>
    </form>

    <!-- 🔥 ACTIONS -->
    <div class="mb-3 text-end">
        <a href="/audit/export<%= user_id ? '?user_id=' + user_id : '' %>"
           class="btn btn-success me-2">
            📁 Export Logs
        </a>
        <a href="/audit/verify?manual=true"
           class="btn btn-warning">
            Verify Logs
        </a>
    </div>

    <!-- 🔥 TABLE -->
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Action</th>
            <th>Quantity</th>
            <th>Block Number</th>
            <th>Previous Hash</th>
            <th>Current Hash</th>
            <th>Time</th>
        </tr>
        </thead>
        <tbody>
        <% if (logs.length === 0) { %>
            <tr>
                <td colspan="7" class="text-center text-danger">
                    No logs found on the blockchain
                </td>
            </tr>
        <% } %>

        <% logs.forEach(log => { %>
        <tr>
            <td><%= log.id %></td>
            <td>
                <span class="badge bg-primary">
                    <%= log.action %>
                </span>
            </td>
            <td><%= log.quantity %></td>
            <td><%= log.block_number %></td>
            <td class="hash">
                <%= log.previous_hash || "GENESIS" %>
            </td>
            <td class="hash">
                <%= log.current_hash %>
            </td>
            <td><%= log.timestamp %></td>
        </tr>
        <% }) %>
        </tbody>
    </table>

</div>

</body>
</html>
